# Arr/media stack environment
# Copy to .env beside arr-stack.yml, then replace placeholders.

# LinuxServer.io container ownership
PUID=1000
PGID=1000
TZ=Asia/Ho_Chi_Minh

# Optional private VPN reminder for local-only config.
# Do not commit real VPN usernames, passwords, client keys, or provider configs.
VPN_PROVIDER=replace-with-vpn-provider-name
VPN_INTERFACE=replace-with-vpn-interface-name
VPN_USERNAME=replace-with-vpn-username
VPN_PASSWORD=replace-with-vpn-password
